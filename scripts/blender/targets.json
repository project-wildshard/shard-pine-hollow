{
 "about": "Every model a Blender script builds (M10, E315; docs/design/blender-practice.md). The script is the source, the GLB it exports is committed, a .blend never is. Run a target from the repo root with `bash node_modules/@wildshard/sdk/scripts/blender/build.sh <target>`, check one against its committed GLB with `--check`. Fields: script (the Blender entry, run with --python-exit-code 1), args, pre (shell, before Blender), sources (every other file the target needs: the SDK's scripts/check-model-sources.mjs refuses a file under src/blender/ that no target names), inputs (committed files it reads), lock (Cycles work: take the model lock), build (files Blender must leave in $BUILD), meshopt / copy ([build file, repo file] pairs), post (shell, after the copies), outputs (the committed files it makes), feeds (the code that loads them), manual (not buildable here: why), check (the command --check runs for a manual target).",
 "blender": {
  "version": "5.2.1",
  "path": "/opt/homebrew/bin/blender"
 },
 "lock": "~/projects/localai/.model.lock",
 "cache": "~/.cache/wildshard-blender",
 "targets": {
  "pine-hollow/area-export": {
   "about": "Pine Hollow's half of the island export (PH-0.3): area.bin, splat.bin, scene.json in the cache. Its Blender build is PINE-HOLLOW-REMASTER wave 2 (PH-U17), so it writes nothing to the repo",
   "pre": [
    "node --no-warnings --import ./src/scripts/bake-loader.mjs scripts/blender/lib/export-scene.mjs --chunk pine-hollow $CACHE"
   ],
   "script": null,
   "sources": [
    "src/blender/export.mjs",
    "scripts/blender/lib/export-scene.mjs"
   ],
   "inputs": [
    "src/static/assets/baked/pine-hollow/terrain.bin"
   ],
   "lock": false,
   "outputs": [],
   "feeds": []
  },
  "pine-hollow/trees": {
   "about": "Pine Hollow's photoreal species set: 14 variants x 5 LOD parts, branch-card + impostor atlases, 4 bark sets (PH-B4)",
   "script": "src/blender/trees/build_trees.py",
   "args": [
    "$BUILD"
   ],
   "sources": [
    "src/blender/trees/treegen.py",
    "src/blender/trees/barkgen.py",
    "scripts/blender/lib/glb.py",
    "src/blender/trees/post.sh"
   ],
   "inputs": [
    "src/static/assets/tex/pine_tree_01/",
    "src/static/assets/tex/pine_bark/"
   ],
   "lock": true,
   "build": [
    "trees.glb",
    "trees.json"
   ],
   "meshopt": [
    [
     "trees.glb",
     "src/static/assets/models/pine-hollow-trees/trees.glb"
    ]
   ],
   "copy": [
    [
     "trees.json",
     "src/static/assets/models/pine-hollow-trees/trees.json"
    ]
   ],
   "post": "src/blender/trees/post.sh",
   "outputs": [
    "src/static/assets/models/pine-hollow-trees/trees.glb",
    "src/static/assets/models/pine-hollow-trees/trees.json",
    "src/static/assets/models/pine-hollow-trees/cards-albedo.png",
    "src/static/assets/models/pine-hollow-trees/impostor-albedo.png",
    "src/static/assets/models/pine-hollow-trees/cards-normal.jpg",
    "src/static/assets/models/pine-hollow-trees/cards-arm.jpg",
    "src/static/assets/models/pine-hollow-trees/impostor-normal.jpg",
    "src/static/assets/tex/fir_bark/",
    "src/static/assets/tex/metasequoia_bark/",
    "src/static/assets/tex/birch_bark/",
    "src/static/assets/tex/bark_willow_02/"
   ],
   "feeds": [
    "src/engine/client/world/forest/treeSet.ts",
    "src/engine/client/world/TreeFactory.ts"
   ]
  },
  "pine-hollow/crags": {
   "about": "The Ridge's granite crag kit: the tors, boulders and scree, 7 modules (PH-B2; E350 F-X1 dropped the five big modules crags-b.glb replaces)",
   "script": "src/blender/crags/build_crags.py",
   "args": [
    "$BUILD"
   ],
   "sources": [
    "src/blender/crags/rocklib.py"
   ],
   "lock": true,
   "build": [
    "crags.glb",
    "crags.json"
   ],
   "meshopt": [
    [
     "crags.glb",
     "src/static/assets/models/pine-hollow-crags/crags.glb"
    ]
   ],
   "copy": [
    [
     "crags.json",
     "src/static/assets/models/pine-hollow-crags/crags.json"
    ]
   ],
   "outputs": [
    "src/static/assets/models/pine-hollow-crags/crags.glb",
    "src/static/assets/models/pine-hollow-crags/crags.json"
   ],
   "feeds": [
    "src/generators/bake-crag-scenes.mjs"
   ]
  },
  "pine-hollow/crags-b": {
   "about": "E322 F-L2 (Jake picked B): the Ridge's big modules fused and weathered (cliff bands, buttress, slab) and the lookout's hero crag, overlaid on crags.glb",
   "script": "src/blender/crags/build_crags_b.py",
   "args": [
    "$BUILD"
   ],
   "sources": [
    "src/blender/crags/rocklib.py"
   ],
   "lock": true,
   "build": [
    "crags-b.glb",
    "crags-b.json"
   ],
   "meshopt": [
    [
     "crags-b.glb",
     "src/static/assets/models/pine-hollow-crags/crags-b.glb"
    ]
   ],
   "copy": [
    [
     "crags-b.json",
     "src/static/assets/models/pine-hollow-crags/crags-b.json"
    ]
   ],
   "outputs": [
    "src/static/assets/models/pine-hollow-crags/crags-b.glb",
    "src/static/assets/models/pine-hollow-crags/crags-b.json"
   ],
   "feeds": [
    "src/generators/bake-crag-scenes.mjs"
   ]
  },
  "pine-hollow/cave": {
   "about": "The Den's bear cave: the interior + the hood over its first metres, fitted to the baked heights round the mouth (PH-B2)",
   "pre": [
    "node --no-warnings --import ./src/scripts/bake-loader.mjs src/blender/crags/export-cave.mjs $BUILD/cave-in.json"
   ],
   "script": "src/blender/crags/build_cave.py",
   "args": [
    "$BUILD/cave-in.json",
    "$BUILD"
   ],
   "sources": [
    "src/blender/crags/rocklib.py",
    "src/blender/crags/export-cave.mjs"
   ],
   "inputs": [
    "src/static/assets/baked/pine-hollow/terrain.bin",
    "src/static/assets/models/pine-hollow-hero/cave-arch/cave-arch.glb"
   ],
   "lock": true,
   "build": [
    "cave.glb",
    "cave.json"
   ],
   "meshopt": [
    [
     "cave.glb",
     "src/static/assets/models/pine-hollow-crags/cave.glb"
    ]
   ],
   "copy": [
    [
     "cave.json",
     "src/static/assets/models/pine-hollow-crags/cave.json"
    ]
   ],
   "outputs": [
    "src/static/assets/models/pine-hollow-crags/cave.glb",
    "src/static/assets/models/pine-hollow-crags/cave.json"
   ],
   "feeds": [
    "src/generators/bake-crag-scenes.mjs"
   ]
  },
  "pine-hollow/lever-rifle": {
   "about": "The lever-action carbine, hi (desktop) + lo (phone), each baked on its own UVs (PH-C11)",
   "pre": [
    "mkdir -p $SHARED/weapons-src && { [ -s $SHARED/weapons-src/walnut_veneer_02_diff_2k.jpg ] || curl -sfL -o $SHARED/weapons-src/walnut_veneer_02_diff_2k.jpg https://dl.polyhaven.org/file/ph-assets/Textures/jpg/2k/walnut_veneer_02/walnut_veneer_02_diff_2k.jpg; }"
   ],
   "script": "src/blender/weapons/lever_rifle.py",
   "args": [
    "$BUILD",
    "--wood=$SHARED/weapons-src/walnut_veneer_02_diff_2k.jpg"
   ],
   "sources": [],
   "inputs": [
    "src/static/assets/hdri/kloofendal_48d_partly_cloudy_puresky_2k.hdr"
   ],
   "lock": true,
   "build": [
    "hi/lever-rifle.glb",
    "lo/lever-rifle.glb"
   ],
   "meshopt": [
    [
     "hi/lever-rifle.glb",
     "src/static/assets/pine-hollow/weapons/lever-rifle.glb"
    ],
    [
     "lo/lever-rifle.glb",
     "src/static/assets/pine-hollow/weapons/lever-rifle.phone.glb"
    ]
   ],
   "outputs": [
    "src/static/assets/pine-hollow/weapons/lever-rifle.glb",
    "src/static/assets/pine-hollow/weapons/lever-rifle.phone.glb"
   ],
   "feeds": [
    "src/data/heldGear.json"
   ]
  },
  "pine-hollow/skinning-knife": {
   "about": "The first-person skinning knife in a gloved hand, hi + lo, one mesh, one material, plus its sidecar points",
   "pre": [
    "mkdir -p $SHARED/weapons-src && { [ -s $SHARED/weapons-src/walnut_veneer_02_diff_2k.jpg ] || curl -sfL -o $SHARED/weapons-src/walnut_veneer_02_diff_2k.jpg https://dl.polyhaven.org/file/ph-assets/Textures/jpg/2k/walnut_veneer_02/walnut_veneer_02_diff_2k.jpg; }"
   ],
   "script": "src/blender/weapons/skinning_knife.py",
   "args": [
    "$BUILD",
    "--wood=$SHARED/weapons-src/walnut_veneer_02_diff_2k.jpg"
   ],
   "sources": [
    "src/blender/weapons/knife-post.sh"
   ],
   "inputs": [
    "src/static/assets/hdri/kloofendal_48d_partly_cloudy_puresky_2k.hdr"
   ],
   "lock": true,
   "build": [
    "hi/skinning-knife.glb",
    "lo/skinning-knife.glb",
    "hi/skinning-knife.json",
    "lo/skinning-knife.json"
   ],
   "meshopt": [
    [
     "hi/skinning-knife.glb",
     "src/static/assets/pine-hollow/weapons/skinning-knife.glb"
    ],
    [
     "lo/skinning-knife.glb",
     "src/static/assets/pine-hollow/weapons/skinning-knife.phone.glb"
    ]
   ],
   "post": "src/blender/weapons/knife-post.sh",
   "outputs": [
    "src/static/assets/pine-hollow/weapons/skinning-knife.glb",
    "src/static/assets/pine-hollow/weapons/skinning-knife.phone.glb",
    "src/static/assets/pine-hollow/weapons/skinning-knife.json"
   ],
   "feeds": [
    "src/data/heldGear.json"
   ]
  }
 }
}

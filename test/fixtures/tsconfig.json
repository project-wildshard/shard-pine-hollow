{
  "compilerOptions": {
    "target": "ES2024",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client",
      "@wildshard/sdk/headless/game/types"
    ],
    "allowArbitraryExtensions": true,
    "exactOptionalPropertyTypes": true
  },
  "files": [
    "builtProduct.ts",
    "headless-worker.ts",
    "headless/pine-contract-compile.ts",
    "headless/pine-director-compile.ts",
    "headless/pine-native-oracle.ts",
    "headless/pine-story-run.ts",
    "headless/pine-witness-run.ts",
    "headless/productSession.ts",
    "native-number-path.ts",
    "native-oracle.ts",
    "native-program.ts",
    "native-rapier-file.ts",
    "pine-checkpoint-provenance.ts",
    "pine-contract-candidate.ts",
    "pine-director-module.ts",
    "pine-emitted-product.ts",
    "pine-native-oracle-inputs.ts",
    "pine-native-oracle-spec.ts",
    "pine-verbs.ts",
    "weapon-oracle/headlessRanged.ts",
    "weapon-oracle/nativeLoadout.ts",
    "witness-checkpoints.ts",
    "witness-generation.ts"
  ],
  "include": [],
  "compileOnSave": false
}
